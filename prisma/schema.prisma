// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  AUCTIONEER
  BIDDER
}

enum LoteStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum WalletTxType {
  DEPOSIT
  BID_LOCK
  BID_RELEASE
  SETTLEMENT_DEBIT
  SETTLEMENT_CREDIT
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  document         String   @unique
  passwordHash     String
  role             UserRole @default(BIDDER)
  publicCode       String   @unique
  maskedName       String
  balanceTotal     BigInt   @default(0)
  balanceCommitted BigInt   @default(0)

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lots               Lot[]
  lotsWon            Lot[]               @relation("LotWinner")
  bids               Bid[]
  walletTransactions WalletTransaction[]
  receipts           Receipt[]

  @@map("users")
}

model Lot {
  id              String     @id @default(uuid())
  title           String
  description     String
  imageUrl        String
  artist          String?
  externalApiId   String?
  startPrice      BigInt
  currentPrice    BigInt
  minIncrement    BigInt
  status          LoteStatus @default(SCHEDULED)
  startTime       DateTime
  endTime         DateTime
  lotSealHash     String? // Hash do lote finalizado
  bidsCount       Int        @default(0)
  currentWinnerId String?
  currentWinner   User?      @relation("LotWinner", fields: [currentWinnerId], references: [id])
  bids            Bid[]
  receipt         Receipt?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User?      @relation(fields: [userId], references: [id])
  userId          String?

  @@index([status, startTime, endTime])
  @@map("lots")
}

model Bid {
  id             String   @id @default(uuid())
  lotId          String
  bidderId       String
  amount         BigInt
  timestamp      DateTime @default(now())
  sequenceNumber Int
  prevHash       String
  bidHash        String
  lot            Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  bidder         User     @relation(fields: [bidderId], references: [id])

  @@unique([lotId, sequenceNumber])
  @@index([lotId, timestamp])
  @@map("bids")
}

model WalletTransaction {
  id           String       @id @default(uuid())
  userId       String
  lotId        String?
  type         WalletTxType
  amount       BigInt
  balanceAfter BigInt
  description  String
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

model Receipt {
  id          String   @id @default(uuid())
  lotId       String   @unique
  winnerId    String
  code        String   @unique
  finalAmount BigInt
  lotSealHash String
  settledAt   DateTime @default(now())
  lot         Lot      @relation(fields: [lotId], references: [id])
  winner      User     @relation(fields: [winnerId], references: [id])

  @@map("receipts")
}

model ExternalItemCache {
  id          String   @id
  title       String
  artist      String?
  dateDisplay String?
  medium      String?
  dimensions  String?
  imageId     String?
  cachedAt    DateTime @default(now())

  @@map("external_items_cache")
}
